# 诛仙知识库（只读）
ZHUXIAN_DB_HOST=localhost
ZHUXIAN_DB_PORT=5432
ZHUXIAN_DB_NAME=zhuxian_novel
ZHUXIAN_DB_USER=noveluser
ZHUXIAN_DB_PASSWORD=[REDACTED]

# 创作工作库（读写）
CREATIVE_DB_HOST=localhost
CREATIVE_DB_PORT=5432
CREATIVE_DB_NAME=novel_studio
CREATIVE_DB_USER=noveluser
CREATIVE_DB_PASSWORD=[REDACTED]

# LLM配置（OpenAI-compatible）
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=[REDACTED]
LLM_MODEL=qwen2.5:14b
# 写作步骤专用模型（可选）：不设则用 LLM_MODEL。写作是质量关键步，可配强模型（如思考模型），审计/修订等用默认快模型
# LLM_WRITER_MODEL=glm-5.2
# 备用模型清单（逗号分隔）：首选模型调用失败（5xx/超时/空内容）后自动逐个切换
# LLM_FALLBACK_MODELS=minimax-m2.7,qwen3.8-max,glm-5.2
# 备用供应商（可选）：不设则与首选同一供应商只换模型；可配置独立备用供应商应对整体宕机
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=[REDACTED]
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.8

# 服务端口
SERVER_PORT=3456

# ===== Python ETL 侧配置（根目录 .env 复用） =====
# 以下配置仅供 sucaiqingxi/ 下的 Python ETL 脚本使用；Node 主服务不读取。
# Python 脚本会自动把上方的 CREATIVE_DB_* 映射为 PG_*，无需重复配置。

# ----- 向量化（本地 bge，与诛仙库同源，勿改维度）-----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 首次运行会从 HuggingFace 下载模型（约100MB）。国内连不上官方站就用镜像：
HF_ENDPOINT=https://hf-mirror.com
# 已在本地缓存过模型（~/.cache/huggingface）就设 1，跳过联网校验、直接用本地：
HF_HUB_OFFLINE=1

# ----- ETL 切块与抽取参数 -----
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
ENABLE_CHUNK_PREFILTER=1
PREFILTER_MIN_EVENTS=5
PREFILTER_MAX_DIALOGUE=0.4
LLM_CONCURRENCY=10
LLM_MAX_RETRIES=3
LLM_JSON_MODE=1
LLM_THINKING=disabled
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=90
MAX_MATERIALS_PER_CHUNK=2
MIN_QUALITY_TO_STORE=6
DEDUP_THRESHOLD=0.86
MAX_CHUNKS=0
ENABLE_VECTOR_BUCKET=0
ENABLE_PRE_DEDUP=0

# ----- Python GUI / Embedding 服务 -----
GUI_PORT=8610
EMBEDDING_SERVER_HOST=0.0.0.0
EMBEDDING_SERVER_PORT=8600
EMBEDDING_SERVER_THREADS=8
