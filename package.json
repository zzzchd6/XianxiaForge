{
  "name": "novel-studio",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter @novel-studio/shared build && pnpm --filter server build && pnpm --filter web build",
    "test": "pnpm --filter server test",
    "test:ai-flavor": "pnpm --filter server test:ai-flavor",
    "db:init": "node scripts/init-db.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "pg": "^8.22.0",
    "typescript": "^5.7.0"
  }
}
